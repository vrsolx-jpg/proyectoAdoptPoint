rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esUsuario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function texto(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function booleanoOpcional(valor) {
      return valor == null || valor is bool;
    }

    function datosValidos(datos) {
      return datos is map
        && datos.keys().hasOnly(['especie', 'descripcion', 'nombre', 'sinNombre', 'raza', 'edad',
          'tamanio', 'esterilizado', 'sexo', 'vacunado', 'desparasitado', 'peso', 'color', 'ciudad',
          'telefono', 'compatibleNinos', 'compatibleMascotas', 'entrenadoCasa', 'veterinario',
          'ultimaVisita', 'proximaCita', 'lugarEncontrado', 'fechaEncontrado'])
        && texto(datos.especie, 50) && datos.especie.size() > 0
        && texto(datos.descripcion, 1000) && datos.descripcion.size() > 0
        && texto(datos.get('nombre', ''), 40) && texto(datos.get('raza', ''), 60)
        && texto(datos.get('tamanio', ''), 20) && texto(datos.get('sexo', ''), 15)
        && texto(datos.get('color', ''), 80) && texto(datos.get('ciudad', ''), 80)
        && texto(datos.get('veterinario', ''), 100)
        && texto(datos.get('ultimaVisita', ''), 10) && texto(datos.get('proximaCita', ''), 10)
        && texto(datos.get('lugarEncontrado', ''), 160) && texto(datos.get('fechaEncontrado', ''), 10)
        && booleanoOpcional(datos.get('sinNombre', null))
        && booleanoOpcional(datos.get('esterilizado', null))
        && booleanoOpcional(datos.get('vacunado', null))
        && booleanoOpcional(datos.get('desparasitado', null))
        && booleanoOpcional(datos.get('compatibleNinos', null))
        && booleanoOpcional(datos.get('compatibleMascotas', null))
        && booleanoOpcional(datos.get('entrenadoCasa', null))
        && (datos.get('peso', null) == null || (datos.peso is number && datos.peso >= 0 && datos.peso <= 100))
        && (datos.get('edad', null) == null || datos.edad in ['cachorro', 'adulto', 'mayor']
          || (datos.edad is number && datos.edad >= 0))
        && (!('telefono' in datos) || (texto(datos.telefono, 12) && datos.telefono.matches('^(57)?3[0-9]{9}$')));
    }

    function fotosValidas(fotos) {
      return fotos is list && fotos.size() <= 3
        && (fotos.size() < 1 || texto(fotos[0], 240000))
        && (fotos.size() < 2 || texto(fotos[1], 240000))
        && (fotos.size() < 3 || texto(fotos[2], 240000));
    }

    function publicacionValida(publicacion) {
      return publicacion.keys().hasOnly(['usuarioId', 'caso', 'datos', 'fotos', 'publicador', 'estado', 'creadaEn'])
        && publicacion.caso in ['hogar', 'encontrado']
        && publicacion.get('estado', 'activa') in ['activa', 'adoptada']
        && (publicacion.get('estado', 'activa') != 'adoptada' || publicacion.caso == 'hogar')
        && texto(publicacion.creadaEn, 30) && texto(publicacion.get('publicador', ''), 60)
        && fotosValidas(publicacion.fotos) && datosValidos(publicacion.datos);
    }

    match /publicaciones/{id} {
      allow read: if true;
      allow create: if esUsuario(request.resource.data.usuarioId) && publicacionValida(request.resource.data);
      allow update: if esUsuario(resource.data.usuarioId)
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.creadaEn == resource.data.creadaEn
        && publicacionValida(request.resource.data);
      allow delete: if esUsuario(resource.data.usuarioId);
    }

    match /usuarios/{uid} {
      allow read: if esUsuario(uid);
      allow create, update: if esUsuario(uid)
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
          .hasOnly(['nombre', 'foto', 'direccion', 'ciudad', 'telefono', 'ubicacionPermitida'])
        && texto(request.resource.data.get('nombre', ''), 60)
        && texto(request.resource.data.get('foto', ''), 160000)
        && texto(request.resource.data.get('direccion', ''), 160)
        && texto(request.resource.data.get('ciudad', ''), 80)
        && request.resource.data.get('ubicacionPermitida', false) is bool
        && texto(request.resource.data.get('telefono', ''), 10)
        && request.resource.data.get('telefono', '').matches('^(3[0-9]{9})?$');

      match /favoritos/{id} {
        allow read, delete: if esUsuario(uid);
        allow create, update: if esUsuario(uid)
          && request.resource.data.keys().hasOnly(['guardadaEn'])
          && request.resource.data.guardadaEn == request.time;
      }
    }

    function publicacionRecibeSolicitud(solicitud) {
      let publicacion = get(/databases/$(database)/documents/publicaciones/$(solicitud.publicacionId)).data;
      return publicacion.usuarioId == solicitud.destinatarioId
        && publicacion.caso in ['hogar', 'encontrado'] && publicacion.get('estado', 'activa') != 'adoptada';
    }

    match /solicitudesAdopcion/{id} {
      allow read: if esUsuario(resource.data.remitenteId) || esUsuario(resource.data.destinatarioId);
      allow create: if esUsuario(request.resource.data.remitenteId)
        && request.resource.data.destinatarioId != request.auth.uid
        && request.resource.data.keys().hasOnly(['publicacionId', 'remitenteId', 'destinatarioId', 'nombreRemitente', 'nombreMascota', 'telefonoRemitente', 'creadaEn', 'leida'])
        && texto(request.resource.data.publicacionId, 500) && texto(request.resource.data.nombreRemitente, 60)
        && texto(request.resource.data.nombreMascota, 100) && texto(request.resource.data.creadaEn, 30)
        && request.resource.data.get('leida', false) == false
        && request.resource.data.telefonoRemitente is string
        && request.resource.data.telefonoRemitente.matches('^3[0-9]{9}$')
        && request.resource.data.telefonoRemitente == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.telefono
        && publicacionRecibeSolicitud(request.resource.data);
      allow update: if esUsuario(resource.data.destinatarioId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
        && request.resource.data.leida == true;
    }
  }
}

